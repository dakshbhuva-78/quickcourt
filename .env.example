# Copy this file to ".env" and change the values. ".env" is git-ignored.
DB_USERNAME=quickcourt
DB_PASSWORD=ChangeMe_Db_Pass_1
DB_ROOT_PASSWORD=ChangeMe_Root_Pass_1
# true = insert demo users/venues on first start. Use false in a real deployment.
SEED_DATA=true

# ---- only needed for the cloud (deploy/docker-compose.prod.yml) ----
DOMAIN=quickcourt.example.com
BACKUP_BUCKET=quickcourt-backups-yourname
